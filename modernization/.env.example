# Backend runtime
PORT=4000
API_BASE_PATH=/api

# Add your deployed frontend domain in production.
# For local development keep * or use http://localhost:4000
CORS_ORIGIN=*

# Data mode:
# - postgres: uses DATABASE_URL
# - file: uses modernization/data/runtime-db.json
DATA_MODE=postgres

# Supabase Postgres connection string (Transaction pooler recommended)
# Example:
# postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Enable PG SSL mode for providers that require TLS.
# Keep true for Supabase.
PG_SSL=true
